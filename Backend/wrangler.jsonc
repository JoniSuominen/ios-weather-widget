{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "readout-oura-broker",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "ratelimits": [
    {
      "name": "OAUTH_RATE_LIMIT",
      "namespace_id": "1061001",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
